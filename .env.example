# Environment variables - Copy this to .env.local and fill in your values

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tune-together?retryWrites=true&w=majority

# RapidAPI (Deezer API)
RAPIDAPI_KEY=your_rapidapi_key

# Tenor v2 (GIFs & stickers in chat) - free key via Google Cloud Console:
# console.cloud.google.com -> enable "Tenor API" -> Credentials -> API key
# Optional: without it the picker falls back to a small curated set
TENOR_API_KEY=your_tenor_api_key
# Legacy alternative (Giphy no longer issues new keys):
# GIPHY_API_KEY=your_giphy_api_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Socket.IO URL (defaults to current origin)
# SOCKET_URL=http://localhost:3000

# Node Environment
NODE_ENV=development

# Logging Level
LOG_LEVEL=info
